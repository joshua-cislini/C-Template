# =============================================================================
# Build output
# =============================================================================
build/
*.o
*.obj
*.d
*.exe
*.pdb
*.ilk

# Exceptions: binaries deliberately dropped into dependencies/ are tracked.
!dependencies/**

# =============================================================================
# Tooling
# =============================================================================
# Generated by make for clangd / clang-tidy (machine-specific absolute paths).
compile_commands.json
# clangd index cache
.cache/
.clangd/

# =============================================================================
# Visual Studio Code (shared project configuration is tracked)
# =============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/.browse.c_cpp.db*

# =============================================================================
# Operating system and editor files
# =============================================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
*.swp
*.swo
*~
*.bak
*.tmp
*.log

# =============================================================================
# Optional: do not commit third-party binaries
# =============================================================================
# Uncomment to keep dependencies/ out of version control (teammates then have
# to download the libraries themselves):
# dependencies/*/
# dependencies/lib/*
# dependencies/bin/*
# dependencies/include/*
# !dependencies/**/.gitkeep
