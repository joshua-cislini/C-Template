# clang-tidy configuration (used by clangd in the editor and by `make tidy`).
# Docs: https://clang.llvm.org/extra/clang-tidy/checks/list.html
#
# A pragmatic set for C: bug finders and static analysis on, purely stylistic
# or very noisy checks off. Tune to taste.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-assignment-in-if-condition,
  -cert-err33-c,
  -misc-include-cleaner,
  -readability-braces-around-statements,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -readability-avoid-unconditional-preprocessor-if,
  -readability-uppercase-literal-suffix,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling

# Only report diagnostics for the project's own headers, never dependencies/.
HeaderFilterRegex: '^.*[/\\](include|src|tests)[/\\].*$'

WarningsAsErrors: ''
FormatStyle: file
