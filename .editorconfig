# https://editorconfig.org - consistent basics across editors and IDEs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Matches .clang-format (UseTab: Always, TabWidth: 4).
[*.{c,h}]
indent_style = tab
tab_width = 4

# Make requires tabs for recipe lines.
[{Makefile,*.mk}]
indent_style = tab
tab_width = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
