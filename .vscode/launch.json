{
	// F5 builds (task "Build") and debugs build/debug/bin/<PROJECT>.
	// By default, PROJECT is the folder name (or set explicitly in config.mk).
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/debug/bin/${workspaceFolderBasename}",
			"args": [],
			"cwd": "${workspaceFolder}",
			"stopAtEntry": false,
			"externalConsole": false,
			"MIMode": "gdb",
			"preLaunchTask": "Build",
			"setupCommands": [
				{
					"description": "Enable pretty-printing",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				}
			],
			"windows": {
				"program": "${workspaceFolder}/build/debug/bin/${workspaceFolderBasename}.exe",
				"miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
				"environment": [
					{
						"name": "PATH",
						"value": "C:\\msys64\\ucrt64\\bin;C:\\msys64\\usr\\bin;${env:PATH}"
					}
				]
			},
			"osx": {
				"MIMode": "lldb"
			}
		},
		{
			// Use this one for programs that read from stdin (scanf, getchar, ...)
			// on Windows, where the debug console cannot forward keyboard input.
			"name": "Debug (external console)",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/debug/bin/${workspaceFolderBasename}",
			"args": [],
			"cwd": "${workspaceFolder}",
			"stopAtEntry": false,
			"externalConsole": true,
			"MIMode": "gdb",
			"preLaunchTask": "Build",
			"setupCommands": [
				{
					"description": "Enable pretty-printing",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				}
			],
			"windows": {
				"program": "${workspaceFolder}/build/debug/bin/${workspaceFolderBasename}.exe",
				"miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
				"environment": [
					{
						"name": "PATH",
						"value": "C:\\msys64\\ucrt64\\bin;C:\\msys64\\usr\\bin;${env:PATH}"
					}
				]
			},
			"osx": {
				"MIMode": "lldb"
			}
		}
	]
}