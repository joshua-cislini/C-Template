# =============================================================================
# Ultimate .clang-format — every option (clang-format 22.1.8), grouped by
# category with descriptions, valid values, and C-Template overrides on an
# LLVM baseline.
# Generated for: clang-format version 22.1.8 (https://github.com/msys2/MINGW-packages d34feaaa1d0aff624c870910b6f2589aa40d20de)
#
# HOW TO USE
#   - Save this file as '.clang-format' (or '_clang-format' on Windows) in
#     your project root. clang-format discovers it automatically.
#   - Edit any value below to change that rule; delete a line to fall back
#     to BasedOnStyle's default for it.
#   - Start from a different base by changing BasedOnStyle to one of:
#     LLVM, GNU, Google, Chromium, Microsoft, Mozilla, WebKit,
#     InheritParentConfig, None.
#   - Docs: https://clang.llvm.org/docs/ClangFormatStyleOptions.html
#
# NOTES
#   - QualifierOrder is commented out because clang-format rejects it unless
#     QualifierAlignment is set to Custom.
#   - Deprecated *MinDigits aliases under IntegerLiteralSeparator are
#     commented out so they do not override *MinDigitsInsert.
#   - InsertTrailingCommas: Wrapped requires BinPackArguments: false and
#     BinPackParameters: OnePerLine or AlwaysOnePerLine.
# =============================================================================
---

# --- General -----------------------------------------------------------------

# Predefined base style whose defaults this config overrides (LLVM | GNU | Google | Chromium | Microsoft | Mozilla | WebKit | InheritParentConfig | None).
BasedOnStyle:    LLVM

# Target language for this configuration block (C | Cpp | CSharp | Java | JavaScript | Json | ObjC | Proto | TableGen | TextProto | Verilog).
# Note: Setting Language: Cpp limits this section to C/C++/ObjC; omit Language or add extra '---' sections for other languages.
Language:        Cpp

# C++ language standard to parse and format for (c++03 | c++11 | c++14 | c++17 | c++20 | Latest | Auto; Cpp03/Cpp11 are deprecated aliases).
Standard:        Latest

# Number of columns per indentation level (unsigned).
# (LLVM default: 2).
IndentWidth:     4

# Maximum line length in columns; 0 disables line wrapping at a column limit (unsigned).
# (LLVM default: 80).
ColumnLimit:     160

# Indentation width for line continuations (unsigned).
# (LLVM default: 4).
ContinuationIndentWidth: 8

# How tab characters are used for indentation and alignment (Never | ForIndentation | ForContinuationAndIndentation | AlignWithSpaces | Always).
# (LLVM default: Never).
UseTab:          Always

# Number of columns per tab stop (unsigned).
# (LLVM default: 8).
TabWidth:        4

# Disable formatting completely (bool: true | false).
DisableFormat:   false

# Line ending style to emit (LF | CRLF | DeriveLF | DeriveCRLF).
LineEnding:      DeriveLF

# Regex matching comment markers that disable formatting for the next single line (string regex).
OneLineFormatOffRegex: ''


# --- Alignment ---------------------------------------------------------------

# Extra indent or outdent applied to access modifiers such as 'public:', relative to IndentWidth (int).
AccessModifierOffset: -2

# Horizontally align arguments after an opening bracket '(', '<', or '[' (bool: true | false; changed from enum to bool in clang-format 22).
# Replaces v18 enum values (Align/DontAlign/AlwaysBreak/BlockIndent); v18 C-Template used Align.
AlignAfterOpenBracket: true

# Align fields of struct array initializers into columns (Left | Right | None).
AlignArrayOfStructures: None

# Alignment settings for consecutive assignment statements.
AlignConsecutiveAssignments:
  # Enable consecutive alignment (bool: true | false).
  Enabled:         false
  # Align across empty lines (bool: true | false).
  AcrossEmptyLines: false
  # Align across comments (bool: true | false).
  AcrossComments:  false
  # Only for AlignConsecutiveAssignments: align compound assignments like += with = (bool: true | false).
  AlignCompound:   false
  # Only for AlignConsecutiveDeclarations: align function declarations (bool: true | false).
  AlignFunctionDeclarations: false
  # Only for AlignConsecutiveDeclarations: align function pointers (bool: true | false).
  AlignFunctionPointers: false
  # Only for AlignConsecutiveAssignments: left-pad shorter operators so all operators align on the right (bool: true | false).
  PadOperators:    true

# Alignment settings for consecutive bit-field declarations.
AlignConsecutiveBitFields:
  # Enable consecutive alignment (bool: true | false).
  Enabled:         false
  # Align across empty lines (bool: true | false).
  AcrossEmptyLines: false
  # Align across comments (bool: true | false).
  AcrossComments:  false
  # Only for AlignConsecutiveAssignments: align compound assignments like += with = (bool: true | false).
  AlignCompound:   false
  # Only for AlignConsecutiveDeclarations: align function declarations (bool: true | false).
  AlignFunctionDeclarations: false
  # Only for AlignConsecutiveDeclarations: align function pointers (bool: true | false).
  AlignFunctionPointers: false
  # Only for AlignConsecutiveAssignments: left-pad shorter operators so all operators align on the right (bool: true | false).
  PadOperators:    false

# Alignment settings for consecutive variable/function declarations.
AlignConsecutiveDeclarations:
  # Enable consecutive alignment (bool: true | false).
  Enabled:         false
  # Align across empty lines (bool: true | false).
  AcrossEmptyLines: false
  # Align across comments (bool: true | false).
  AcrossComments:  false
  # Only for AlignConsecutiveAssignments: align compound assignments like += with = (bool: true | false).
  AlignCompound:   false
  # Only for AlignConsecutiveDeclarations: align function declarations (bool: true | false).
  AlignFunctionDeclarations: true
  # Only for AlignConsecutiveDeclarations: align function pointers (bool: true | false).
  AlignFunctionPointers: false
  # Only for AlignConsecutiveAssignments: left-pad shorter operators so all operators align on the right (bool: true | false).
  PadOperators:    false

# Alignment settings for consecutive #define macro definitions.
AlignConsecutiveMacros:
  # Enable consecutive alignment (bool: true | false).
  Enabled:         false
  # Align across empty lines (bool: true | false).
  AcrossEmptyLines: false
  # Align across comments (bool: true | false).
  AcrossComments:  false
  # Only for AlignConsecutiveAssignments: align compound assignments like += with = (bool: true | false).
  AlignCompound:   false
  # Only for AlignConsecutiveDeclarations: align function declarations (bool: true | false).
  AlignFunctionDeclarations: false
  # Only for AlignConsecutiveDeclarations: align function pointers (bool: true | false).
  AlignFunctionPointers: false
  # Only for AlignConsecutiveAssignments: left-pad shorter operators so all operators align on the right (bool: true | false).
  PadOperators:    false

# Alignment settings for consecutive short case statements (applies when AllowShortCaseExpressionOnASingleLine or AllowShortCaseLabelsOnASingleLine is true).
AlignConsecutiveShortCaseStatements:
  # Enable aligning consecutive short case statements (bool: true | false).
  Enabled:         false
  # Align across empty lines (bool: true | false).
  AcrossEmptyLines: false
  # Align across comments (bool: true | false).
  AcrossComments:  false
  # Align '=>' arrows in short case expressions (bool: true | false).
  AlignCaseArrows: false
  # Align on the ':' rather than the tokens after ':' (bool: true | false).
  AlignCaseColons: false

# Alignment settings for consecutive TableGen DAGArg operator colons.
AlignConsecutiveTableGenBreakingDAGArgColons:
  # Enable consecutive alignment (bool: true | false).
  Enabled:         false
  # Align across empty lines (bool: true | false).
  AcrossEmptyLines: false
  # Align across comments (bool: true | false).
  AcrossComments:  false
  # Only for AlignConsecutiveAssignments: align compound assignments like += with = (bool: true | false).
  AlignCompound:   false
  # Only for AlignConsecutiveDeclarations: align function declarations (bool: true | false).
  AlignFunctionDeclarations: false
  # Only for AlignConsecutiveDeclarations: align function pointers (bool: true | false).
  AlignFunctionPointers: false
  # Only for AlignConsecutiveAssignments: left-pad shorter operators so all operators align on the right (bool: true | false).
  PadOperators:    false

# Alignment settings for consecutive TableGen !cond operator colons.
AlignConsecutiveTableGenCondOperatorColons:
  # Enable consecutive alignment (bool: true | false).
  Enabled:         false
  # Align across empty lines (bool: true | false).
  AcrossEmptyLines: false
  # Align across comments (bool: true | false).
  AcrossComments:  false
  # Only for AlignConsecutiveAssignments: align compound assignments like += with = (bool: true | false).
  AlignCompound:   false
  # Only for AlignConsecutiveDeclarations: align function declarations (bool: true | false).
  AlignFunctionDeclarations: false
  # Only for AlignConsecutiveDeclarations: align function pointers (bool: true | false).
  AlignFunctionPointers: false
  # Only for AlignConsecutiveAssignments: left-pad shorter operators so all operators align on the right (bool: true | false).
  PadOperators:    false

# Alignment settings for consecutive TableGen definition inheritance colons.
AlignConsecutiveTableGenDefinitionColons:
  # Enable consecutive alignment (bool: true | false).
  Enabled:         false
  # Align across empty lines (bool: true | false).
  AcrossEmptyLines: false
  # Align across comments (bool: true | false).
  AcrossComments:  false
  # Only for AlignConsecutiveAssignments: align compound assignments like += with = (bool: true | false).
  AlignCompound:   false
  # Only for AlignConsecutiveDeclarations: align function declarations (bool: true | false).
  AlignFunctionDeclarations: false
  # Only for AlignConsecutiveDeclarations: align function pointers (bool: true | false).
  AlignFunctionPointers: false
  # Only for AlignConsecutiveAssignments: left-pad shorter operators so all operators align on the right (bool: true | false).
  PadOperators:    false

# Alignment of trailing backslashes in multi-line macros (DontAlign | Left | LeftWithLastLine | Right).
AlignEscapedNewlines: Right

# Horizontally align operands of wrapped binary and ternary expressions (DontAlign | Align | AlignAfterOperator).
AlignOperands:   Align

# Alignment settings for trailing line comments (// ...).
AlignTrailingComments:
  # Align trailing comments on preprocessor directives with non-preprocessor ones (bool: true | false).
  AlignPPAndNotPP: true
  # How to align trailing comments (Leave | Always | Never).
  Kind:            Always
  # Number of empty lines across which trailing comments are aligned (unsigned).
  OverEmptyLines:  0


# --- Allow-on-a-single-line rules --------------------------------------------

# Allow placing all call/braced-init arguments together on the next line if they don't fit on the current line (bool: true | false).
AllowAllArgumentsOnNextLine: true

# Allow placing all function declaration parameters together on the next line even when BinPackParameters is OnePerLine (bool: true | false).
AllowAllParametersOfDeclarationOnNextLine: true

# Allow a line break before a noexcept specifier (Never | OnlyWithParen | Always).
AllowBreakBeforeNoexceptSpecifier: Never

# Allow breaking before Qt Q_PROPERTY keywords (READ, WRITE, etc.) as if separated by commas (bool: true | false).
AllowBreakBeforeQtProperty: false

# Allow short blocks like 'while (true) { continue; }' on one line (Never | Empty | Always).
AllowShortBlocksOnASingleLine: Never

# Allow short switch labeled expressions/rules on a single line (bool: true | false).
AllowShortCaseExpressionOnASingleLine: true

# Allow short case labels like 'case 1: x = 1; break;' on a single line (bool: true | false).
# (LLVM default: false).
AllowShortCaseLabelsOnASingleLine: true

# Allow short C++20 compound requirements on a single line (bool: true | false).
AllowShortCompoundRequirementOnASingleLine: true

# Allow short enum definitions on a single line (bool: true | false).
AllowShortEnumsOnASingleLine: true

# Allow short functions on a single line (None | InlineOnly | Empty | Inline | All).
AllowShortFunctionsOnASingleLine: All

# Allow short if/else statements on a single line (Never | WithoutElse | OnlyFirstIf | AllIfsAndElse).
# (LLVM default: Never).
AllowShortIfStatementsOnASingleLine: AllIfsAndElse

# Allow short lambda expressions on a single line (None | Empty | Inline | All).
AllowShortLambdasOnASingleLine: All

# Allow short single-statement loops like 'while (true) continue;' on a single line (bool: true | false).
# (LLVM default: false).
AllowShortLoopsOnASingleLine: true

# Allow short namespaces like 'namespace a { class b; }' on a single line (bool: true | false).
AllowShortNamespacesOnASingleLine: false


# --- Breaking rules ----------------------------------------------------------

# [DEPRECATED: use BreakAfterReturnType] Line break style after function definition return types (None | All | TopLevel).
# Retained for compatibility; v18 C-Template kept None.
AlwaysBreakAfterDefinitionReturnType: None

# Always break before multi-line string literals (bool: true | false).
AlwaysBreakBeforeMultilineStrings: false

# Break between adjacent string literals when wrapping (bool: true | false).
BreakAdjacentStringLiterals: true

# Break after C++11 attributes before declarations or control statements (Always | Leave | Never).
BreakAfterAttributes: Leave

# Break after each annotation on a field in Java (bool: true | false).
BreakAfterJavaFieldAnnotations: false

# Force a break after '{' of a braced initializer list (when Cpp11BracedListStyle is FunctionCall/AlignFirstComment) if it exceeds ColumnLimit (bool: true | false).
BreakAfterOpenBracketBracedList: false

# Force a break after '(' of a function declaration/definition/call if parameters exceed ColumnLimit (bool: true | false).
BreakAfterOpenBracketFunction: false

# Force a break after '(' of an 'if' statement if the condition exceeds ColumnLimit (bool: true | false).
BreakAfterOpenBracketIf: false

# Force a break after '(' of a loop statement if the header exceeds ColumnLimit (bool: true | false).
BreakAfterOpenBracketLoop: false

# Force a break after '(' of a 'switch' statement if the condition exceeds ColumnLimit (bool: true | false).
BreakAfterOpenBracketSwitch: false

# Line break style after function declaration/definition return types (Automatic | ExceptShortType | All | TopLevel | AllDefinitions | TopLevelDefinitions; None is deprecated).
# Replaces deprecated AlwaysBreakAfterReturnType (v18 C-Template used None).
BreakAfterReturnType: None

# For JSON: always break after '[' instead of keeping short arrays on one line (bool: true | false).
BreakArrays:     true

# Line breaking around binary operators (None: break after | NonAssignment: break before except '=' | All: break before).
BreakBeforeBinaryOperators: None

# Brace placement preset (Attach | Linux | Mozilla | Stroustrup | Allman | Whitesmiths | GNU | WebKit | Custom).
BreakBeforeBraces: Attach

# Fine-grained brace wrapping flags (used only when BreakBeforeBraces is set to Custom).
BraceWrapping:
  # Wrap before '{' of case labels (bool: true | false).
  AfterCaseLabel:  false
  # Wrap before '{' of class definitions (bool: true | false).
  AfterClass:      false
  # Wrap before '{' of control statements like if/for/while/switch (Never | MultiLine | Always).
  AfterControlStatement: Never
  # Wrap before '{' of enum definitions (bool: true | false).
  AfterEnum:       false
  # Wrap before '{' of extern blocks (bool: true | false).
  AfterExternBlock: false
  # Wrap before '{' of function definitions (bool: true | false).
  AfterFunction:   false
  # Wrap before '{' of namespace definitions (bool: true | false).
  AfterNamespace:  false
  # Wrap before '{' of Objective-C declarations (bool: true | false).
  AfterObjCDeclaration: false
  # Wrap before '{' of struct definitions (bool: true | false).
  AfterStruct:     false
  # Wrap before '{' of union definitions (bool: true | false).
  AfterUnion:      false
  # Wrap before 'catch' (bool: true | false).
  BeforeCatch:     false
  # Wrap before 'else' (bool: true | false).
  BeforeElse:      false
  # Wrap before '{' of lambda bodies (bool: true | false).
  BeforeLambdaBody: false
  # Wrap before 'while' in do-while loops (bool: true | false).
  BeforeWhile:     false
  # Indent the wrapped braces themselves (bool: true | false).
  IndentBraces:    false
  # Put empty function bodies on multiple lines when AfterFunction wraps (bool: true | false).
  SplitEmptyFunction: true
  # Put empty class/struct/union bodies on multiple lines when wrapped (bool: true | false).
  SplitEmptyRecord: true
  # Put empty namespace bodies on multiple lines when AfterNamespace wraps (bool: true | false).
  SplitEmptyNamespace: true

# Force a break before '}' of a braced initializer list when it exceeds ColumnLimit (bool: true | false).
BreakBeforeCloseBracketBracedList: false

# Force a break before ')' of a function declaration/definition/call when parameters exceed ColumnLimit (bool: true | false).
BreakBeforeCloseBracketFunction: false

# Force a break before ')' of an 'if' statement when it exceeds ColumnLimit and broke after '(' (bool: true | false).
BreakBeforeCloseBracketIf: false

# Force a break before ')' of a loop statement when it exceeds ColumnLimit and broke after '(' (bool: true | false).
BreakBeforeCloseBracketLoop: false

# Force a break before ')' of a 'switch' statement when it exceeds ColumnLimit (bool: true | false).
BreakBeforeCloseBracketSwitch: false

# Whether to break before 'concept' after a template declaration (Never | Allowed | Always).
BreakBeforeConceptDeclarations: Always

# Whether to break before ':' in inline assembly statements (Never | OnlyMultiline | Always).
BreakBeforeInlineASMColon: OnlyMultiline

# Break before template closing '>' when there is a break after '<' (bool: true | false).
BreakBeforeTemplateCloser: false

# Place ternary '?' and ':' operators at the start of wrapped lines (bool: true | false).
BreakBeforeTernaryOperators: true

# How to break chained binary operations (Never | OnePerLine | RespectPrecedence).
BreakBinaryOperations: Never

# Break style for constructor initializer lists (BeforeColon | BeforeComma | AfterColon).
BreakConstructorInitializers: BeforeColon

# Always break before function definition parameter lists (bool: true | false).
BreakFunctionDefinitionParameters: false

# Break style for class inheritance lists (BeforeColon | BeforeComma | AfterColon | AfterComma).
BreakInheritanceList: BeforeColon

# Allow splitting long string literals across multiple lines (bool: true | false).
BreakStringLiterals: true

# Break after template<...> declarations (Leave | No | MultiLine | Yes; false/true are aliases for No/Yes).
# Replaces deprecated AlwaysBreakTemplateDeclarations (v18 C-Template used MultiLine).
BreakTemplateDeclarations: MultiLine


# --- Comments, includes & macros ---------------------------------------------

# Regex matching special comments that must not be split or reflowed (string regex).
CommentPragmas:  '^ IWYU pragma:'

# Comment indentation and line-wrapping behavior (Never | IndentOnly | Always).
# Replaces v18 bool true/false (true -> Always, false -> Never).
ReflowComments:  Always

# How multiple #include blocks are grouped when sorting includes (Preserve | Merge | Regroup).
IncludeBlocks:   Preserve

# Ordered regex rules assigning Priority, SortPriority, and CaseSensitive matching to #include paths (list of maps).
# Entry keys: Regex (POSIX extended), Priority (int, lower first), SortPriority (int, for Regroup), CaseSensitive (bool)
IncludeCategories:
  - Regex:           '^"(llvm|llvm-c|clang|clang-c)/'
    Priority:        2
    SortPriority:    0
    CaseSensitive:   false
  - Regex:           '^(<|"(gtest|gmock|isl|json)/)'
    Priority:        3
    SortPriority:    0
    CaseSensitive:   false
  - Regex:           '.*'
    Priority:        1
    SortPriority:    0
    CaseSensitive:   false

# Regex of allowed suffixes between a source filename stem and its main header (string regex).
IncludeIsMainRegex: '(Test)?$'

# Regex for source file extensions/suffixes considered 'main' files for main-header detection (string regex).
IncludeIsMainSourceRegex: ''

# Delimiter required on #include directives to match the main header (Quote | AngleBracket | Any).
MainIncludeChar: Quote

# Settings controlling #include directive sorting.
# Replaces v18 scalar enum (Never/CaseSensitive/CaseInsensitive); v18 C-Template used CaseSensitive (Enabled: true, IgnoreCase: false).
SortIncludes:
  # Enable sorting #include directives (bool: true | false).
  Enabled:         true
  # Sort #includes case-insensitively (bool: true | false).
  IgnoreCase:      false
  # Ignore file extensions when sorting unless paths otherwise compare equal (bool: true | false).
  IgnoreExtension: false

# How to sort C++ 'using' declarations (Never | Lexicographic | LexicographicNumeric).
SortUsingDeclarations: LexicographicNumeric

# Where to place static imports when sorting Java imports (Before | After).
SortJavaStaticImport: Before

# Ordered package prefixes defining empty-line-separated groups for Java imports (list of strings).
JavaImportGroups: []

# Identifiers interpreted as attributes/qualifiers rather than regular identifiers (list of strings).
AttributeMacros:
  - __capability

# Macros treated as range/foreach loops rather than function calls (list of strings).
ForEachMacros:
  - foreach
  - Q_FOREACH
  - BOOST_FOREACH

# Macros treated as conditionals rather than function calls (list of strings).
IfMacros:
  - KJ_IF_MAYBE

# Regex matching macros that begin an indented block (string regex).
MacroBlockBegin: ''

# Regex matching macros that end an indented block (string regex).
MacroBlockEnd:   ''

# Macro expansion definitions in '<definition>=<expansion>' form used during formatting (list of strings).
Macros:          []

# Function-like macros whose invocations are skipped by RemoveParentheses (list of strings).
MacrosSkippedByRemoveParentheses: []

# Macros that open namespace-like blocks, e.g. TESTSUITE (list of strings).
NamespaceMacros: []

# Macros ignored in front of statements as if they were attributes, e.g. Qt Q_EMIT (list of strings).
StatementAttributeLikeMacros:
  - Q_EMIT

# Macros interpreted as complete statements, e.g. Q_UNUSED (list of strings).
StatementMacros:
  - Q_UNUSED
  - QT_REQUIRE_VERSION

# Non-keyword identifiers treated as template names so '<' is parsed as a template opener (list of strings).
TemplateNames:   []

# Non-keyword identifiers treated as type names for pointer/reference vs binary operator disambiguation (list of strings).
TypeNames:       []

# Macros interpreted as type declarations instead of function calls, e.g. STACK_OF (list of strings).
TypenameMacros:  []

# Non-keyword identifiers treated as variable template names (list of strings).
VariableTemplates: []

# Macros whose internal whitespace must not be altered, e.g. STRINGIZE (list of strings).
WhitespaceSensitiveMacros:
  - BOOST_PP_STRINGIZE
  - CF_SWIFT_NAME
  - NS_SWIFT_NAME
  - PP_STRINGIZE
  - STRINGIZE

# Skip formatting the body of #define macro definitions (bool: true | false).
SkipMacroDefinitionBody: false

# Experimentally detect whether calls/definitions in the file use one-per-line or bin-packed style (bool: true | false).
ExperimentalAutoDetectBinPacking: false


# --- Namespaces --------------------------------------------------------------

# Place consecutive nested namespace declarations on the same line (bool: true | false).
CompactNamespaces: false

# Add missing or fix invalid closing '// namespace ...' comments (bool: true | false).
FixNamespaceComments: true

# Maximum unwrapped lines a namespace may span to still be treated as short by FixNamespaceComments (unsigned).
ShortNamespaceLines: 1

# Indentation inside namespace blocks (None | Inner | All).
NamespaceIndentation: None

# Empty lines immediately inside namespace opening and closing braces (Never | Always | Leave).
WrapNamespaceBodyWithEmptyLines: Leave


# --- Indentation -------------------------------------------------------------

# Columns to indent contents of braced initializer lists; if negative, ContinuationIndentWidth is used (int).
BracedInitializerIndentWidth: -1

# Indentation width for constructor initializer lists and inheritance lists (unsigned).
ConstructorInitializerIndentWidth: 4

# Give access modifiers their own indentation level relative to the surrounding class/struct (bool: true | false).
IndentAccessModifiers: false

# Indent braced blocks inside switch case labels one level further from the case label (bool: true | false).
IndentCaseBlocks: false

# Indent switch case labels one level inside the switch statement (bool: true | false).
# (LLVM default: false).
IndentCaseLabels: true

# Indent the body of C++20 'export { ... }' blocks (bool: true | false).
IndentExportBlock: true

# Indentation of 'extern "C" { ... }' blocks (AfterExternBlock | NoIndent | Indent).
IndentExternBlock: AfterExternBlock

# Indent goto labels; if false, labels are flush left (bool: true | false).
IndentGotoLabels: true

# Indentation of preprocessor directives (None | AfterHash | BeforeHash | Leave).
IndentPPDirectives: None

# Indentation width for preprocessor directives; -1 uses IndentWidth (int).
PPIndentWidth:   -1

# Indent C++20 requires clauses in templates when placed on their own line or with following declaration (bool: true | false).
IndentRequiresClause: true

# Placement of C++20 requires clauses (OwnLine | OwnLineWithBrace | WithPreceding | WithFollowing | SingleLine).
RequiresClausePosition: OwnLine

# Indentation base for C++20 requires expression bodies (OuterScope | Keyword).
RequiresExpressionIndentation: OuterScope

# Indent function names when wrapped onto a new line after the return type (bool: true | false).
IndentWrappedFunctionNames: false

# Indentation base for lambda bodies (Signature | OuterScope).
LambdaBodyIndentation: Signature


# --- Spacing -----------------------------------------------------------------

# Spacing around ':' in bit-field declarations (Both | None | Before | After).
BitFieldColonSpacing: Both

# Insert a space after C-style casts like '(int) x' (bool: true | false).
SpaceAfterCStyleCast: false

# Insert a space after logical NOT '!' (bool: true | false).
SpaceAfterLogicalNot: false

# Insert a space after the 'operator' keyword (bool: true | false).
SpaceAfterOperatorKeyword: false

# Insert a space after the 'template' keyword (bool: true | false).
SpaceAfterTemplateKeyword: true

# Spacing around pointer qualifiers like 'const' in 'void *const p' (Default | Before | After | Both).
SpaceAroundPointerQualifiers: Default

# Insert a space before assignment operators like '=' and '+=' (bool: true | false).
SpaceBeforeAssignmentOperators: true

# Insert a space before ':' in case labels (bool: true | false).
SpaceBeforeCaseColon: false

# Insert a space before a C++11 braced initializer list (bool: true | false).
# (LLVM default: false).
SpaceBeforeCpp11BracedList: true

# Insert a space before ':' in constructor initializer lists (bool: true | false).
SpaceBeforeCtorInitializerColon: true

# Insert a space before ':' in class inheritance lists (bool: true | false).
SpaceBeforeInheritanceColon: true

# Insert a space before ':' in JSON objects (bool: true | false).
SpaceBeforeJsonColon: false

# When to insert a space before '(' (ControlStatements | ControlStatementsExceptControlMacros | NonEmptyParentheses | Always | Custom; Never is deprecated).
# Note: In clang-format 19+, 'Never' acts as a deprecated alias for 'Custom' with SpaceBeforeParensOptions set to false (except AfterPlacementOperator).
# (LLVM default: ControlStatements).
SpaceBeforeParens: Never

# Fine-grained space-before-parentheses flags (used when SpaceBeforeParens is set to Custom).
# Active when SpaceBeforeParens is Custom (while SpaceBeforeParens: Never is set above, clang-format overrides control/macro flags to false).
SpaceBeforeParensOptions:
  # Space after control keywords like if/for/while/switch (bool: true | false).
  AfterControlStatements: true
  # Space after macros listed in ForEachMacros (bool: true | false).
  AfterForeachMacros: true
  # Space between function definition name and '(' (bool: true | false).
  AfterFunctionDefinitionName: false
  # Space between function declaration name and '(' (bool: true | false).
  AfterFunctionDeclarationName: false
  # Space after macros listed in IfMacros (bool: true | false).
  AfterIfMacros:   true
  # Space between alternative operator 'not' and '(' (bool: true | false).
  AfterNot:        false
  # Space between overloaded operator name and '(' (bool: true | false).
  AfterOverloadedOperator: false
  # Space between operator new/delete and '(' (bool: true | false).
  AfterPlacementOperator: true
  # Space between 'requires' keyword in a requires clause and '(' (bool: true | false).
  AfterRequiresInClause: false
  # Space between 'requires' keyword in a requires expression and '(' (bool: true | false).
  AfterRequiresInExpression: false
  # Space before '(' only when the parentheses are non-empty (bool: true | false).
  BeforeNonEmptyParentheses: false

# Insert a space before ':' in range-based for loops (bool: true | false).
SpaceBeforeRangeBasedForLoopColon: true

# Insert a space before '[' except on lambdas (bool: true | false).
SpaceBeforeSquareBrackets: false

# When to insert a space inside empty braces '{}' (Always | Block | Never).
# Replaces deprecated SpaceInEmptyBlock (v18 C-Template used false -> Never).
SpaceInEmptyBraces: Never

# Number of spaces before trailing // line comments (unsigned).
SpacesBeforeTrailingComments: 1

# Spaces inside template angle brackets '<...>' (Never | Always | Leave).
SpacesInAngles:  Never

# Insert spaces inside container literals such as ObjC/JS arrays and dicts (bool: true | false).
SpacesInContainerLiterals: true

# Allowed leading spaces after '//' in single-line comments.
SpacesInLineCommentPrefix:
  # Minimum number of spaces at the start of a // line comment (unsigned).
  Minimum:         1
  # Maximum number of spaces at the start of a // line comment (-1 disables maximum).
  Maximum:         -1

# When to insert spaces after '(' and before ')' (Never | Custom).
SpacesInParens:  Never

# Fine-grained space-inside-parentheses flags (used when SpacesInParens is set to Custom).
SpacesInParensOptions:
  # Prevent adding spaces when both '(' and ')' are doubled, e.g. ((x)) (bool: true | false).
  ExceptDoubleParentheses: false
  # Insert spaces inside C-style cast parentheses (bool: true | false).
  InCStyleCasts:   false
  # Insert spaces inside if/for/while/switch condition parentheses (bool: true | false).
  InConditionalStatements: false
  # Insert a space inside empty parentheses '()' (bool: true | false).
  InEmptyParentheses: false
  # Insert spaces inside parentheses not covered by the other options (bool: true | false).
  Other:           false

# Insert spaces inside '[...]' except empty lambdas or unsized array declarations (bool: true | false).
SpacesInSquareBrackets: false


# --- Empty lines -------------------------------------------------------------

# Empty lines after access modifiers like 'public:' (Never | Leave | Always).
EmptyLineAfterAccessModifier: Never

# Empty lines before access modifiers (Never | Leave | LogicalBlock | Always).
EmptyLineBeforeAccessModifier: LogicalBlock

# Maximum number of consecutive empty lines to keep (unsigned).
MaxEmptyLinesToKeep: 1

# Which empty lines are preserved (see MaxEmptyLinesToKeep for consecutive limit).
# Replaces deprecated KeepEmptyLinesAtTheStartOfBlocks (true) and KeepEmptyLinesAtEOF (false).
KeepEmptyLines:
  # Keep empty lines at the end of a file (bool: true | false).
  AtEndOfFile:     false
  # Keep empty lines at the start of a block (bool: true | false).
  AtStartOfBlock:  true
  # Keep empty lines at the start of a file (bool: true | false).
  AtStartOfFile:   true

# Preserve form feed characters (^L) surrounded by newlines (bool: true | false).
KeepFormFeed:    false

# Remove empty lines inside statements/unwrapped lines (bool: true | false).
RemoveEmptyLinesInUnwrappedLines: false

# Empty lines separating top-level/class/struct/enum/function definition blocks (Leave | Always | Never).
SeparateDefinitionBlocks: Leave

# Ensure the formatted file ends with a trailing newline (bool: true | false).
InsertNewlineAtEOF: false


# --- Pointers, references & qualifiers ---------------------------------------

# Alignment of '*' and '&' in declarations (Left | Right | Middle).
PointerAlignment: Right

# Alignment of '&' and '&&', optionally overriding PointerAlignment (Pointer | Left | Right | Middle).
ReferenceAlignment: Pointer

# Infer PointerAlignment and ReferenceAlignment from the file's existing majority style (bool: true | false).
DerivePointerAlignment: false

# Arrangement of cv/specifier qualifiers like const/volatile (Leave | Left | Right | Custom; Custom requires QualifierOrder).
QualifierAlignment: Leave

# Order of qualifiers when QualifierAlignment is Custom (must contain 'type'; allowed: const, inline, static, friend, constexpr, volatile, restrict, type).
# NOTE: Kept commented out because clang-format rejects QualifierOrder unless QualifierAlignment is set to Custom.
# QualifierOrder: [inline, static, type, const, volatile]


# --- Braced init lists, constructors & bin-packing ---------------------------

# How braced initializer lists are formatted (Block | FunctionCall | AlignFirstComment).
# Replaces v18 bool true/false (v18 C-Template used true; LLVM v22 default is AlignFirstComment).
Cpp11BracedListStyle: AlignFirstComment

# If true, pack multiple call arguments per line; if false, put all on one line or one per line (bool: true | false).
BinPackArguments: true

# Override BinPackArguments: false and bin-pack braced initializer lists with 20 or more items (bool: true | false).
BinPackLongBracedList: true

# How to pack function declaration/definition parameters (BinPack | OnePerLine | AlwaysOnePerLine).
# Replaces v18 bool true/false (v18 C-Template used true -> BinPack).
BinPackParameters: BinPack

# Packing style for constructor initializer lists (Never | BinPack | CurrentLine | NextLine | NextLineOnly).
PackConstructorInitializers: BinPack

# Insert trailing commas in multi-line container literals (None | Wrapped; Wrapped requires BinPackArguments: false and BinPackParameters: OnePerLine/AlwaysOnePerLine).
InsertTrailingCommas: None

# Handling of trailing commas in enum enumerator lists (Leave | Insert | Remove).
EnumTrailingComma: Leave


# --- Braces / control-flow & token rewriting (use with care) -----------------

# Insert braces around single-statement control flow bodies (if/else/for/do/while) in C++ (bool: true | false).
InsertBraces:    false

# Remove optional braces on single-statement control blocks (if/else/for/while) per LLVM style (bool: true | false).
RemoveBracesLLVM: false

# Remove redundant parentheses (Leave | MultipleParentheses | ReturnStatement).
RemoveParentheses: Leave

# Remove redundant semicolons after closing braces of functions/constructors/destructors (bool: true | false).
RemoveSemicolon: false


# --- Integer literal separators & numeric literals ---------------------------

# Grouping and digit thresholds for integer literal separators (' in C++, _ in C#/Java/JS).
IntegerLiteralSeparator:
  # Digit group size for binary literals (-1: remove, 0: leave as is, >0: group size).
  Binary:          0
  # Minimum digits required before inserting separators in binary literals (0: no minimum).
  BinaryMinDigitsInsert: 0
  # Maximum digits up to which separators are always removed in binary literals (0: disabled).
  BinaryMaxDigitsRemove: 0
  # Digit group size for decimal literals (-1: remove, 0: leave as is, >0: group size).
  Decimal:         0
  # Minimum digits required before inserting separators in decimal literals (0: no minimum).
  DecimalMinDigitsInsert: 0
  # Maximum digits up to which separators are always removed in decimal literals (0: disabled).
  DecimalMaxDigitsRemove: 0
  # Digit group size for hexadecimal literals (-1: remove, 0: leave as is, >0: group size).
  Hex:             0
  # Minimum digits required before inserting separators in hexadecimal literals (0: no minimum).
  HexMinDigitsInsert: 0
  # Maximum digits up to which separators are always removed in hexadecimal literals (0: disabled).
  HexMaxDigitsRemove: 0
  # DEPRECATED alias for BinaryMinDigitsInsert (do not keep both enabled, or this value overrides BinaryMinDigitsInsert).
  # BinaryMinDigits: 0
  # DEPRECATED alias for DecimalMinDigitsInsert (do not keep both enabled, or this value overrides DecimalMinDigitsInsert).
  # DecimalMinDigits: 0
  # DEPRECATED alias for HexMinDigitsInsert (do not keep both enabled, or this value overrides HexMinDigitsInsert).
  # HexMinDigits:    0

# Letter-casing rules for numeric literal components (prefix, hex digits, exponent, suffix).
NumericLiteralCase:
  # Case for floating-point exponent letters like e/E or p/P (Leave | Upper | Lower).
  ExponentLetter:  Leave
  # Case for hexadecimal digits A-F / a-f (Leave | Upper | Lower).
  HexDigit:        Leave
  # Case for numeric prefixes like 0x/0b (Leave | Upper | Lower).
  Prefix:          Leave
  # Case for numeric literal suffixes excluding reserved ones like min (Leave | Upper | Lower).
  Suffix:          Leave


# --- Penalties (tie-breakers the line-wrapping algorithm optimizes over) -----

# Penalty for breaking around an assignment operator (unsigned).
PenaltyBreakAssignment: 2

# Penalty for breaking immediately after '(' in a function call (unsigned).
PenaltyBreakBeforeFirstCallParameter: 19

# Penalty for breaking before '.' or '->' member access operators (unsigned).
PenaltyBreakBeforeMemberAccess: 150

# Penalty for each line break introduced inside a comment (unsigned).
PenaltyBreakComment: 300

# Penalty for breaking before the first '<<' operator (unsigned).
PenaltyBreakFirstLessLess: 120

# Penalty for breaking after '(' (unsigned).
PenaltyBreakOpenParenthesis: 0

# Penalty for breaking after '::' scope resolution operator (unsigned).
PenaltyBreakScopeResolution: 500

# Penalty for each line break introduced inside a string literal (unsigned).
PenaltyBreakString: 1000

# Penalty for breaking after a template declaration (unsigned).
PenaltyBreakTemplateDeclaration: 10

# Penalty for each character exceeding ColumnLimit (unsigned).
PenaltyExcessCharacter: 1000000

# Penalty per character of indentation whitespace (unsigned).
PenaltyIndentedWhitespace: 0

# Penalty for placing a function's return type on its own line (unsigned).
PenaltyReturnTypeOnItsOwnLine: 60


# --- Objective-C -------------------------------------------------------------

# Bin-packing behavior for Objective-C protocol conformance lists (Auto | Always | Never).
ObjCBinPackProtocolList: Auto

# Indentation width for Objective-C block literals (unsigned).
ObjCBlockIndentWidth: 2

# Break parameter lists onto lines when a call contains nested Objective-C block parameters (bool: true | false).
ObjCBreakBeforeNestedBlockParam: true

# Preferred ordering of Objective-C @property attributes, e.g. [class, direct, atomic, nonatomic, ...] (list of strings).
ObjCPropertyAttributeOrder: []

# Insert a space after '@property' in Objective-C, e.g. '@property (readonly)' (bool: true | false).
ObjCSpaceAfterProperty: false

# Insert a space before Objective-C protocol lists, e.g. 'Foo <Protocol>' (bool: true | false).
ObjCSpaceBeforeProtocolList: true


# --- JavaScript / TableGen / Verilog / Raw strings ---------------------------

# Quote style for JavaScript strings (Leave | Single | Double).
JavaScriptQuotes: Leave

# Wrap long JavaScript import/export statements (bool: true | false).
JavaScriptWrapImports: true

# Line breaking inside TableGen DAGArg lists (DontBreak | BreakElements | BreakAll).
TableGenBreakInsideDAGArg: DontBreak

# TableGen DAGArg operator names allowed to break when TableGenBreakInsideDAGArg is not DontBreak (list of strings).
TableGenBreakingDAGArgOperators: []

# In Verilog, place each port connection on its own line in module instantiations (bool: true | false).
VerilogBreakBetweenInstancePorts: true

# Sub-formatting hints for C++ raw string literals (list of maps with keys: Language, Delimiters, EnclosingFunctions, CanonicalDelimiter, BasedOnStyle).
RawStringFormats: []
# Example:
# RawStringFormats:
#   - Language:          Cpp
#     Delimiters:        [cc, cpp]
#     EnclosingFunctions: []
#     CanonicalDelimiter: cc
#     BasedOnStyle:      LLVM

# --- Upcoming options (clang-format 23+, commented out) ----------------------

# Uncomment if using clang-format 23 or newer:
# AllowShortRecordOnASingleLine: Never            # v23: `struct bar { int i; };` on one line
# BreakBeforeReturnType: None                     # v23: force break before return type
# BreakFunctionDeclarationParameters: false       # v23: always break before function declaration parameters

...
