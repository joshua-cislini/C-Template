# =============================================================================
# Build output
# =============================================================================
build/
*.o
*.obj
*.d
*.exe
*.pdb
*.ilk

# Exceptions: third-party libraries and runtime DLLs dropped into lib/ or bin/ are tracked.
!lib/**
!bin/**

# =============================================================================
# Tooling
# =============================================================================
# Generated by make for clangd / clang-tidy (machine-specific absolute paths).
compile_commands.json
# clangd index cache
.cache/
.clangd/

# =============================================================================
# Visual Studio Code (shared project configuration is tracked)
# =============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/README.md
.vscode/.browse.c_cpp.db*

# =============================================================================
# Operating system and editor files
# =============================================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
*.swp
*.swo
*~
*.bak
*.tmp
*.log

# =============================================================================
# Optional: do not commit third-party binaries
# =============================================================================
# Uncomment to keep lib/ and bin/ out of version control (teammates then have
# to download the libraries themselves):
# lib/*
# !lib/README.md
# bin/*
# !bin/README.md
