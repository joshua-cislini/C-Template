{
	// clangd provides IntelliSense (from compile_commands.json, generated by make);
	// the Microsoft C/C++ extension is only used for debugging.
	"C_Cpp.intelliSenseEngine": "disabled",
	"clangd.arguments": [
		"--background-index",
		"--clang-tidy",
		"--completion-style=detailed",
		"--header-insertion=never",
		"--query-driver=**/*gcc*,**/*clang*,**/cc*"
	],

	"[c]": {
		"editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
		"editor.formatOnSave": true
	},
	"files.associations": {
		"*.h": "c",
		"*.mk": "makefile"
	},

	"files.exclude": {
		"**/.cache": true
	},
	"search.exclude": {
		"build": true,
		"lib": true,
		"bin": true
	}
}
